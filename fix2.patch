+    /**
+     * LabyMod brings its own desktop (glibc) LWJGL natives, and LWJGL prefers natives found on the classpath
+     * over the Android ones. LWJGL looks into "org.lwjgl.librarypath" before it looks at the classpath, so we copy
+     * the Android natives that ship with the launcher into a readable folder and point LWJGL there.
+     * (The launcher's own native library folder is not accessible for LWJGL's check.)
+     * @return the folder to be used as org.lwjgl.librarypath, or null if the natives could not be prepared
+     */
+    public static String prepareLwjglNatives(Context context, String nativeLibDir) {
+        File outDir = new File(context.getCacheDir(), "labymod_lwjgl_natives");
+        try {
+            if(!outDir.isDirectory() && !outDir.mkdirs()) throw new IOException("Can't create " + outDir);
+            int copied = 0;
+            File[] existing = new File(nativeLibDir).listFiles();
+            if(existing != null) {
+                for(File file : existing) {
+                    if(!isLwjglNative(file.getName())) continue;
+                    copyIfChanged(file, new File(outDir, file.getName()));
+                    copied++;
+                }
+            }
+            if(copied == 0) {
+                // The libraries are not unpacked on the disk, take them straight from the APK
+                String abiFolder = abiFolderFor(new File(nativeLibDir).getName());
+                try (ZipFile apk = new ZipFile(context.getApplicationInfo().sourceDir)) {
+                    Enumeration<? extends ZipEntry> entries = apk.entries();
+                    while(entries.hasMoreElements()) {
+                        ZipEntry entry = entries.nextElement();
+                        String entryName = entry.getName();
+                        if(entry.isDirectory() || !entryName.startsWith("lib/" + abiFolder + "/")) continue;
+                        String fileName = entryName.substring(entryName.lastIndexOf('/') + 1);
+                        if(!isLwjglNative(fileName)) continue;
+                        File target = new File(outDir, fileName);
+                        if(target.isFile() && target.length() == entry.getSize()) { copied++; continue; }
+                        try (InputStream in = apk.getInputStream(entry)) {
+                            writeStream(in, target);
+                        }
+                        copied++;
+                    }
+                }
+            }
+            Log.i("LabyModUtils", "Prepared " + copied + " LWJGL natives in " + outDir);
+            return copied > 0 ? outDir.getAbsolutePath() : null;
+        }catch (IOException e) {
+            Log.e("LabyModUtils", "Failed to prepare LWJGL natives", e);
+            return null;
+        }
+    }
+
+    static boolean isLwjglNative(String fileName) {
+        return fileName.startsWith("liblwjgl") || fileName.equals("libopenal.so")
+                || fileName.equals("libglfw.so") || fileName.equals("libfreetype.so");
+    }
+
+    /** nativeLibraryDir ends with the short ABI name ("arm64"), while the APK uses the long one ("arm64-v8a") */
+    static String abiFolderFor(String shortName) {
+        switch (shortName) {
+            case "arm64": return "arm64-v8a";
+            case "arm": return "armeabi-v7a";
+            case "x86": return "x86";
+            case "x86_64": return "x86_64";
+            default: return Build.SUPPORTED_ABIS[0];
+        }
+    }
+
+    private static void copyIfChanged(File source, File target) throws IOException {
+        if(target.isFile() && target.length() == source.length()) return;
+        try (InputStream in = new java.io.FileInputStream(source)) {
+            writeStream(in, target);
+        }
+    }
+
+    private static void writeStream(InputStream in, File target) throws IOException {
+        File temp = new File(target.getParentFile(), target.getName() + ".part");
+        try (OutputStream out = new FileOutputStream(temp)) {
+            byte[] buffer = new byte[16384];
+            int read;
+            while((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+        }
+        if(target.exists() && !target.delete()) throw new IOException("Can't replace " + target);
+        if(!temp.renameTo(target)) throw new IOException("Can't move " + temp + " to " + target);
+    }
